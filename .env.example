# ==========================================
# Autonomous Agent Platform Configuration
# ==========================================

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/agent_platform
DATABASE_SYNC_URL=postgresql://postgres:postgrespassword@localhost:5432/agent_platform

# OpenAI API Configuration (Optional: fallback deterministic engine is used if omitted)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
DEFAULT_MODEL=gpt-4o-mini

# Agent Constraints & Execution Bounds
MAX_STEPS_LIMIT=12
MAX_TOOL_CALLS_PER_STEP=4
DEFAULT_TOKEN_BUDGET=50000
DEFAULT_WALL_CLOCK_TIMEOUT=180.0
MAX_CONSECUTIVE_FAILURES=3
MAX_TOOL_RETRIES=2

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
